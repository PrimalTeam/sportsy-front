{
    // Run "Sportsy (dev)" against a local backend and "Sportsy (prod)" against production.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sportsy (dev)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=API_ENV=dev"]
        },
        {
            "name": "Sportsy (prod)",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define=API_ENV=prod"]
        },
        {
            "name": "Sportsy (prod, release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--dart-define=API_ENV=prod"]
        }
    ]
}
